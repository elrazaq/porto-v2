# Database: Local PostgreSQL or Neon Serverless
# Local: postgresql://starter:starter@localhost:5432/starter?schema=public
# Neon (Production): postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://starter:starter@localhost:5432/starter?schema=public"

# Auth Secrets (Generate secure random 32+ char strings)
JWT_ACCESS_SECRET="replace-with-a-random-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-refresh-secret-at-least-32-characters"
WEB_ORIGIN="http://localhost:5173"

# Cloudinary Credentials (Asset management for projects, gallery & skills)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="portfolio"

